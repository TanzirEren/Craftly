<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="btnBack"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="Craftly"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="btnUndo"
            android:src="@drawable/ic_undo"
            android:tint="@color/text" />
        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="btnRedo"
            android:src="@drawable/ic_redo"
            android:tint="@color/text" />
        <ImageButton
            android:id="@+id/btnLayers"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="btnLayers"
            android:src="@drawable/ic_layers"
            android:tint="@color/text" />
        <ImageButton
            android:id="@+id/btnExport"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="btnExport"
            android:src="@drawable/ic_download"
            android:tint="@color/text" />
    </LinearLayout>

    <com.craftly.studio.design.CanvasView
        android:id="@+id/canvasView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabFont"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp"
                    android:text="FONT"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tabColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp"
                    android:text="COLOR"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tabStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp"
                    android:text="STYLE"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tabAdjust"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp"
                    android:text="ADJUST"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tabActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp"
                    android:text="ACTIONS"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="124dp">

            <HorizontalScrollView
                android:id="@+id/pageFont"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/fontList"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/pageColor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/colorList"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/pageStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBold"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="B"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btnItalic"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="I"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="italic" />
            <TextView
                android:id="@+id/btnAlignL"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Left"
                android:textColor="@color/text"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/btnAlignC"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Center"
                android:textColor="@color/text"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/btnAlignR"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Right"
                android:textColor="@color/text"
                android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

            <TextView
                android:id="@+id/btnEditText"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Edit text"
                android:textColor="@color/text"
                android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/pageAdjust"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="Opacity"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/sbOpacity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rowSize"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="Size"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/sbSize"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rowSpacing"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="Letter spacing"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/sbSpacing"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rowLine"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="Line spacing"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/sbLine"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <HorizontalScrollView
                android:id="@+id/pageActions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/actDup"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:drawableTop="@drawable/ic_copy"
                    android:drawableTint="@color/text"
                    android:gravity="center"
                    android:paddingTop="30dp"
                    android:paddingBottom="30dp"
                    android:text="Duplicate"
                    android:textColor="@color/text"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/actDel"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:drawableTop="@drawable/ic_delete"
                    android:drawableTint="@color/text"
                    android:gravity="center"
                    android:paddingTop="30dp"
                    android:paddingBottom="30dp"
                    android:text="Delete"
                    android:textColor="@color/text"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/actFront"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:drawableTop="@drawable/ic_up"
                    android:drawableTint="@color/text"
                    android:gravity="center"
                    android:paddingTop="30dp"
                    android:paddingBottom="30dp"
                    android:text="Forward"
                    android:textColor="@color/text"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/actBack"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:drawableTop="@drawable/ic_down"
                    android:drawableTint="@color/text"
                    android:gravity="center"
                    android:paddingTop="30dp"
                    android:paddingBottom="30dp"
                    android:text="Backward"
                    android:textColor="@color/text"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/actLock"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:drawableTop="@drawable/ic_lock_open"
                    android:drawableTint="@color/text"
                    android:gravity="center"
                    android:paddingTop="30dp"
                    android:paddingBottom="30dp"
                    android:text="Lock"
                    android:textColor="@color/text"
                    android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/surface"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnAddText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_text"
                android:tint="@color/text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Text"
                android:textColor="@color/text"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnAddImage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_image"
                android:tint="@color/text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Image"
                android:textColor="@color/text"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnBackground"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_palette"
                android:tint="@color/text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Background"
                android:textColor="@color/text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
